{
  "name": "factory-layer",
  "version": "0.0.0",
  "private": true,
  "description": "A software factory: a one-page product spec in, a tested TypeScript project out.",
  "license": "UNLICENSED",
  "bin": {
    "factory": "src/cli/index.ts"
  },
  "type": "module",
  "scripts": {
    "factory": "bun run src/cli/index.ts",
    "check": "bash scripts/check.sh",
    "check:fast": "bash scripts/check.sh fast",
    "check:standard": "bash scripts/check.sh standard",
    "test": "bun test src scripts tests/integration/support",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src scripts tests",
    "format": "oxfmt src scripts tests package.json tsconfig.json knip.json .oxlintrc.json .oxfmtrc.json .dependency-cruiser.cjs",
    "format:check": "oxfmt --check src scripts tests package.json tsconfig.json knip.json .oxlintrc.json .oxfmtrc.json .dependency-cruiser.cjs",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:dead": "knip",
    "check:size": "bun run scripts/size-check.ts src",
    "check:headers": "bun run scripts/header-check.ts src scripts tests",
    "build": "bun build src/cli/index.ts --target=bun --outdir dist",
    "audit": "bun audit",
    "hooks:install": "lefthook install",
    "apb:bootstrap": "bun run scripts/apb-bootstrap.ts",
    "e2e": "bun run scripts/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozaik-ai/core": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/bun": "1.4.4",
    "dependency-cruiser": "18.7.0",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
