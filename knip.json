{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts!",
    "!scripts/*.test.ts!",
    "src/**/*.test.ts",
    "src/**/testing/index.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/*.ts"
  ],
  "project": ["src/**/*.ts!", "!src/**/testing/**!", "scripts/**/*.ts!", "tests/**/*.ts"],
  "ignoreDependencies": ["@swc/core"],
  "ignoreBinaries": ["pgrep"],
  "tags": ["-pending"],
  "ignoreExportsUsedInFile": true
}
