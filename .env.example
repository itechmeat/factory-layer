# Set to 1 to use the JigJoy gateway as the brain's first choice (demo only; unset keeps Z.ai primary).
FACTORY_BRAIN_GATEWAY=
# Anthropic through the JigJoy gateway; read only when the flag above is 1, then both are required.
# Z.ai below becomes the fallback. Never use ANTHROPIC_* names.
JIGJOY_ANTHROPIC_BASE_URL=
JIGJOY_ANTHROPIC_API_KEY=
# JIGJOY_ANTHROPIC_MODEL=claude-sonnet-4-6

# Brain model: an OpenAI-compatible endpoint.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3-flash

# Fallback provider (optional): used when the providers above are rate-limited, down or refused.
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=
# FALLBACK_MODEL=

# Memory: a dedicated Open Second Brain vault for the factory, never a
# personal one. Absolute paths to the vault directory and to its config file;
# the memory smoke starts `o2b mcp --config <config> --vault <vault>`.
FACTORY_OSB_VAULT=
FACTORY_OSB_CONFIG=

# Mozaik Cloud (optional, opt-in): with FACTORY_MOZAIK_CLOUD=1 and a key, the brain's
# prompts (spec text, task descriptions, redacted executor reports) are sent to Mozaik Cloud.
# MOZAIK_REDACTION defaults to content (texts sent as sizes only); none sends them in full.
# FACTORY_MOZAIK_CLOUD=1
# MOZAIK_API_KEY=
# MOZAIK_PROJECT_ID=
# MOZAIK_REDACTION=content
