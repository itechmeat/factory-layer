# https://editorconfig.org - the settings a formatter cannot carry into an
# editor. `oxfmt` (`.oxfmtrc.json`) owns everything inside a JS/TS file; this
# owns what happens before it runs, and the files it does not format
# (Markdown, YAML, shell).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
